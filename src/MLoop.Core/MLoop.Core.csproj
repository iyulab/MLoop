<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Published with the CLI at the same version (in-process library — umbrella policy 7′). -->
    <IsPackable>true</IsPackable>
    <PackageId>MLoop.Core</PackageId>
    <Description>MLoop Core - training (a trainer search over ML.NET trainers), prediction and model management on ML.NET</Description>
    <PackageTags>mlops;automl;mlnet;machine-learning;training;prediction</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML" />
    <PackageReference Include="Microsoft.ML.OnnxConverter" />
    <!-- Trainers, transforms and the ONNX Runtime managed API this assembly calls by name —
         declared, as they are the ones it uses (they once arrived only through Microsoft.ML.AutoML). -->
    <PackageReference Include="Microsoft.ML.FastTree" />
    <PackageReference Include="Microsoft.ML.LightGbm" />
    <PackageReference Include="Microsoft.ML.TimeSeries" />
    <PackageReference Include="Microsoft.ML.Recommender" />
    <PackageReference Include="Microsoft.ML.ImageAnalytics" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Microsoft.Data.Analysis" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MLoop.Extensibility\MLoop.Extensibility.csproj" />
    <!-- The trainer search: column roles, trial results, the metric policy. Packed as its own
         package at the same version, so the published MLoop.Core depends on MLoop.Search. -->
    <ProjectReference Include="..\MLoop.Search\MLoop.Search.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MLoop.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FilePrepper" />
  </ItemGroup>

  <!--
    Security floor (CVE-2026-26127 / NU1903): Microsoft.Bcl.Memory is a *transitive*
    dependency of the ML.NET graph that resolves to the vulnerable 9.0.4 by default.
    Directory.Packages.props pins 9.0.14 via CentralPackageTransitivePinningEnabled, but
    that pin is repo-build-scoped and does NOT cross the ProjectReference boundary — a
    submodule/in-process consumer of MLoop.Core would silently inherit 9.0.4. Declaring the
    (CPM-versioned) reference *directly* makes 9.0.14 a resolved direct dependency so the
    fixed floor propagates to every ProjectReference consumer. Do not remove as "unused":
    it is intentionally direct to carry the security floor across the assembly boundary.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.Memory" />
  </ItemGroup>

</Project>
