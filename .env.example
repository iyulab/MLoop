# MLoop reads a .env file at the project root, when one is present, before running a command.
# Copy this file to .env and uncomment what you need. None of these is required.

# Model to act on when a command is given no --name (default: "default").
# MLOOP_MODEL_NAME=default

# Path to MLoop.API.dll for `mloop serve`, when it is not found next to the CLI.
# MLOOP_API_PATH=

# Signing key for `mloop serve` outside Development (at least 32 characters).
# Jwt__Key=
