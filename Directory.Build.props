<Project>
  <PropertyGroup>
    <!-- Common properties for all projects -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Package metadata -->
    <Authors>MLoop Contributors</Authors>
    <Company>iyulab</Company>
    <Product>MLoop</Product>
    <Copyright>Copyright © MLoop Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/iyulab/MLoop</PackageProjectUrl>
    <RepositoryUrl>https://github.com/iyulab/MLoop</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <Version>0.47.0</Version>

    <!-- Packable: MLoop.CLI (dotnet tool) and the in-process library MLoop.Core with what it depends
         on — MLoop.Extensibility and MLoop.Search — all at this version. The rest is not published. -->
    <IsPackable>false</IsPackable>

    <!-- Build settings -->
    <!-- A warning fails the build: the tree builds clean on every OS CI runs, and warnings that
         only printed went unread (documentation comments naming half of two records' parameters,
         twelve per build). Vulnerability advisories stay warnings — a new advisory against a pinned
         package is news for the security scan, not a reason the tree stops building. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Deterministic build -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Source Link for debugging NuGet packages -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Source Link package for GitHub -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
