<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Tests only: ONNX Runtime's native library, so `mloop embed` runs without the on-demand runtime. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\MLoop.CLI\MLoop.CLI.csproj" />
    <ProjectReference Include="..\MLoop.Tests.Common\MLoop.Tests.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The image-encoder fixtures MLoop.Core.Tests writes its expectations from (make_fixtures.py there). -->
    <None Include="..\MLoop.Core.Tests\Fixtures\embedding\*.png;..\MLoop.Core.Tests\Fixtures\embedding\*.onnx;..\MLoop.Core.Tests\Fixtures\embedding\*.json" Link="Fixtures\embedding\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
