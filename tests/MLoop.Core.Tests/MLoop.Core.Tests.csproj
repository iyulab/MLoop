<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <!-- Tests only: the upstream oracle MLoop.Search's tuner is checked against, trial for trial
         (TunerTraceTests). No product project references it. -->
    <PackageReference Include="Microsoft.ML.AutoML" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MLoop.Core\MLoop.Core.csproj" />
    <ProjectReference Include="..\..\src\MLoop.Extensibility\MLoop.Extensibility.csproj" />
    <ProjectReference Include="..\MLoop.Tests.Common\MLoop.Tests.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden files are read from the output: a deterministic build maps source paths to /_/. -->
    <None Update="Data/Golden/**" CopyToOutputDirectory="PreserveNewest" Link="Golden/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
