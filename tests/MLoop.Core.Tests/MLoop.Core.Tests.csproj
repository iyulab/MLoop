<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Tests only: ONNX Runtime with its native library, so graph tests (export verification, image encoders)
         run without the on-demand runtime. The product ships only the managed half. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MLoop.Core\MLoop.Core.csproj" />
    <ProjectReference Include="..\..\src\MLoop.Extensibility\MLoop.Extensibility.csproj" />
    <ProjectReference Include="..\MLoop.Tests.Common\MLoop.Tests.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden files are read from the output: a deterministic build maps source paths to /_/. -->
    <None Update="Data/Golden/**" CopyToOutputDirectory="PreserveNewest" Link="Golden/%(Filename)%(Extension)" />
    <None Include="Fixtures/embedding/*.png;Fixtures/embedding/*.onnx;Fixtures/embedding/*.json;Fixtures/embedding/*.model" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
