<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Tests only: ONNX Runtime's native library, so POST /embed runs without the on-demand runtime. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The image-encoder fixtures MLoop.Core.Tests writes its expectations from (make_fixtures.py there). -->
    <None Include="..\MLoop.Core.Tests\Fixtures\embedding\*.png;..\MLoop.Core.Tests\Fixtures\embedding\*.onnx;..\MLoop.Core.Tests\Fixtures\embedding\*.json;..\MLoop.Core.Tests\Fixtures\embedding\*.model" Link="Fixtures\embedding\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\MLoop.API\MLoop.API.csproj" />
    <ProjectReference Include="..\MLoop.Tests.Common\MLoop.Tests.Common.csproj" />
  </ItemGroup>

</Project>
