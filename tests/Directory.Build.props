<Project>

  <!-- Chain to the repository-wide properties; a Directory.Build.props here would otherwise
       shadow them for every test project. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- xUnit1051 (pass TestContext.Current.CancellationToken): its code fix rewrites every awaited call
         and folds multi-line calls onto one line; these suites do not rely on cancelling a test. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <!-- Code coverage under the Microsoft Testing Platform (dotnet test, coverage option): one extension for every test assembly. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every test assembly pins the same output culture the product pins, so a suite asserts
         what a user actually sees rather than what this machine's locale happens to render.
         Linked from one file: a per-project copy is how the pin drifts between assemblies.
         Test assemblies only — the shared helper library is not one, and a library has no business
         pinning process-wide culture. The pin is MLoop.Core's, so an assembly that must not know
         MLoop.Core (MLoopCoreTestHelpers=false) renders nothing a user reads and goes without it. -->
    <Compile Include="$(MSBuildThisFileDirectory)TestOutputCulture.cs" Link="TestOutputCulture.cs"
             Condition="$(MSBuildProjectName.EndsWith('.Tests')) And '$(MLoopCoreTestHelpers)' != 'false'" />
    <!-- SDCA pinned to one thread for model fixtures: see the file. Same linking reason. -->
    <Compile Include="$(MSBuildThisFileDirectory)DeterministicTrainers.cs" Link="DeterministicTrainers.cs"
             Condition="$(MSBuildProjectName.EndsWith('.Tests'))" />
    <!-- A fact that needs the time-series native skips where it is absent: see the file. It reads
         MLoop.Core, so a test assembly that must not know MLoop.Core sets MLoopCoreTestHelpers=false. -->
    <Compile Include="$(MSBuildThisFileDirectory)TimeSeriesNativeFact.cs" Link="TimeSeriesNativeFact.cs"
             Condition="$(MSBuildProjectName.EndsWith('.Tests')) And '$(MLoopCoreTestHelpers)' != 'false'" />
  </ItemGroup>

</Project>
