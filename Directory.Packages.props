<Project>
  <!-- Enable Central Package Management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- ML.NET Core Packages -->
    <PackageVersion Include="Microsoft.ML" Version="5.0.1" />
    <PackageVersion Include="Microsoft.ML.OnnxConverter" Version="0.23.1" />
    <!-- Components MLoop.Core calls directly. They used to arrive only through Microsoft.ML.AutoML,
         so nothing in the graph said MLoop needed them; declared here, they outlived that package. -->
    <PackageVersion Include="Microsoft.ML.FastTree" Version="5.0.1" />
    <PackageVersion Include="Microsoft.ML.LightGbm" Version="5.0.1" />
    <PackageVersion Include="Microsoft.ML.TimeSeries" Version="5.0.1" />
    <PackageVersion Include="Microsoft.ML.Recommender" Version="0.23.1" />
    <PackageVersion Include="Microsoft.ML.ImageAnalytics" Version="5.0.1" />
    <!-- Decodes images for the embedding path straight (unpremultiplied); the same version ImageAnalytics brings. -->
    <PackageVersion Include="SkiaSharp" Version="2.88.8" />
    <!-- The managed half of ONNX Runtime ships with MLoop; `mloop runtime install onnxruntime`
         downloads the native half at the same version (RuntimeRegistry.OnnxRuntime reads it from
         the loaded assembly). The test project's full package must stay on this version too. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.31.0" />
    <!-- Test-only: runs exported graphs to prove they answer what the ML.NET model answers. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageVersion Include="Microsoft.ML.TorchSharp" Version="0.23.1" />
    <PackageVersion Include="Microsoft.ML.Vision" Version="5.0.1" />
    <!-- ASP.NET Core Packages -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- Logging Packages -->
    <!-- Pin the transitive Serilog core so CLI (Serilog.Sinks.Console → 4.0.0) and API
         (Serilog.AspNetCore → 4.3.0) resolve the SAME version. Without this, the two
         project graphs pick different Serilog.dll versions, and D11's set-difference
         bundle (which shares same-named DLLs) would ship the CLI's 4.0.0 where the API's
         deps.json demands 4.3.0 → serve's API child fails to bind Serilog. -->
    <PackageVersion Include="Serilog" Version="4.3.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Microsoft Extensions -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    <!-- Roslyn / Code Analysis -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
    <!-- Data Processing -->
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="Microsoft.Data.Analysis" Version="0.23.1" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- CLI / Console -->
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
    <PackageVersion Include="DotNetEnv" Version="3.2.0" />
    <!-- Documentation / API -->
    <!-- Stay on the Microsoft.OpenApi 2.x line: Swashbuckle.AspNetCore is built against 2.x — with
         10.3.1 and 3.11.0, /swagger/v1/swagger.json still answers 500 (re-measured; the Swagger tests
         in MLoop.API.Tests catch it). Its nuspec says only ">= 2.7.5", so restore would not stop a 3.x.
         Revisit when a Swashbuckle release depends on 3.x. 2.13.0 is the latest 2.x, past the
         GHSA-v5pm-xwqc-g5wc patch (2.7.5). -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <!-- External Dependencies -->
    <PackageVersion Include="FilePrepper" Version="0.12.0" />
    <PackageVersion Include="DataLens" Version="0.19.2" />
    <!-- Resilience / Polly -->
    <PackageVersion Include="Polly.Core" Version="8.6.5" />
    <!-- Security: Override transitive dependency (CVE-2026-26127, GHSA-73j8-2gch-69rq) -->
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="9.0.14" />
    <!-- Testing Packages -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <!-- Source Link for debugging -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
  </ItemGroup>
</Project>